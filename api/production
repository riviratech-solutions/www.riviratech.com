Recommended: run with systemd
Create a service:
sudo nano /etc/systemd/system/riviratech-api.service

--------------------------------- production dev

[Unit]
Description=riviratech Node API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/www.riviratech.com/api
Environment=NODE_ENV=dev
Environment=PORT=5001
EnvironmentFile=/home/www.riviratech.com/.env
ExecStart=/usr/bin/node /home/www.riviratech.com/api/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target


